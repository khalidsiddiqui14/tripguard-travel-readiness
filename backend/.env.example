# TripGuard Backend Environment Variables
# Is file ko copy karke .env bana lo:
# cp .env.example .env

APP_NAME=TripGuard
APP_ENV=development

# JWT Secret - Deployment se pehle isko lambi random string se badal dena
SECRET_KEY=replace-this-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# Local / Quick Demo ke liye SQLite (default)
DATABASE_URL=sqlite:///./tripguard.db

# PDF / Production ke liye PostgreSQL - isko uncomment karke upar wali line comment kar dena
# DATABASE_URL=postgresql+psycopg://tripguard:password@localhost:5432/tripguard

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- External APIs ---
API_TIMEOUT_SECONDS=8